Options All -Indexes


RewriteEngine on

RewriteRule ^([-a-zA-Z0-9]+)$ index.php?action=$1
# Bloquear descarga de respaldos y scripts de base de datos
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>
# Cookie de sesión: no legible desde JavaScript, no se envía desde otros sitios
# y no se acepta un identificador de sesión inventado. (cookie_secure va en el
# php.ini del servidor con HTTPS: ver mantenimiento/LEEME.md)
<IfModule php_module>
    php_flag session.cookie_httponly On
    php_value session.cookie_samesite Lax
    php_flag session.use_strict_mode On
</IfModule>
